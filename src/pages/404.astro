---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." page="notfound">
  <section class="hero page ph-services">
    <div class="hero-inner"><div class="wrap rise">
      <span class="tag">Error 404</span>
      <h1>Page not <em>found.</em></h1>
      <p class="sub">The page you were looking for has moved or no longer exists.</p>
    </div></div>
  </section>
  <div class="body">
    <section class="sec">
      <div class="wrap"><p><a class="btn dark plate" href="/">Back to home <span class="ar">→</span></a></p></div>
    </section>
  </div>
</BaseLayout>
