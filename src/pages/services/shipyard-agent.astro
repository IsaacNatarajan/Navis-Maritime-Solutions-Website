---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Shipyards Agent & Representative" description="Official commercial partner for premier shipyards, with direct access to secured drydock slots." nav="services" page="service-shipyard-agent" mainClass="svc-detail">

  <section class="hero page ph-service sd-hero">
    <div class="hero-inner"><div class="wrap sd-grid">
      <div class="rise">
        <span class="tag">Service 02 of 8</span>
        <h1>Shipyards Agent &amp; Representative</h1>
        <p class="sub">Official commercial partner for premier shipyards, with direct access to secured drydock slots.</p>
      </div>
    </div></div>
  </section>
  <div class="body">
    <div class="wrap sd-wrap">
      <nav class="crumbs"><a href="/services/">← All services</a><span>/</span><b>Shipyards Agent &amp; Representative</b></nav>
      
      <div class="sd-top reveal">
        <figure class="sd-pic plate">
          <img src="/images/svc-shipyard.jpg" style="object-position: 50% 50%" alt="Shipyards Agent &amp; Representative">
          
        </figure>
        <section class="sd-block first">
          <h4><span>01</span>What we do</h4>
          <p>We act as the official commercial partner and authorized agent for premier regional and international shipyards. By bridging the gap between global fabrication facilities and vessel operators, we provide shipowners with immediate access to secured drydock slots, while driving a high-yield contract pipeline directly into our represented shipyards.</p>
          
        </section>
      </div>
      
      <section class="sd-block reveal">
        <h4><span>02</span>Why partner with us</h4>
        
        
        <p>We sit at the precise intersection of global shipyard capacity and regional fleet demand. Because our team operates with deep technical and commercial expertise inside major maritime hubs, we eliminate the traditional friction of international ship repair tendering, ensuring shipyards maintain full order books and shipowners secure preferred yard access on optimal commercial terms.</p>
      </section>
      
      <div class="sd-talk plate reveal">
        <span class="eyebrow">Talk to our team</span>
        <h3>Interested in Shipyards Agent &amp; Representative?</h3>
        <p>Tell us about your vessel or project and we'll come back with a clear plan.</p>
        <a class="btn plate" href="/contact/">Enquire now <span class="ar">→</span></a>
      </div>
      <nav class="sd-pn">
        <a href="/services/project-management/"><span class="k">← Previous</span><span class="t">Project Management Services</span></a>
        <a class="sd-all btn dark plate" href="/services/">All services</a>
        <a class="r" href="/services/spare-parts/"><span class="k">Next →</span><span class="t">Spare Parts Supply &amp; Support</span></a>
      </nav>
    </div>
    
  </div>
</BaseLayout>
