---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Services" description="Eight maritime services from one partner: project management, shipyard representation, spare parts, engineering, product representation, chartering, welding and inspection." nav="services" page="services">

  <section class="hero page ph-services">
    <div class="hero-inner"><div class="wrap rise">
      <span class="tag">Our core services</span>
      <h1>Eight services. <em>One partner.</em></h1>
      <p class="sub">Representation, engineering, supply and inspection for shipowners and shipyards.</p>
    </div></div>
  </section>
  <div class="body">
    <section class="sec reveal">
      <div class="wrap svc-grid">
        <div class="svc-intro">
          <span class="eyebrow">Our core services</span>
          <h2>Choose a service to read more.</h2>
          <p>Select any service to see what it covers, why clients choose Navis for it, and how to get started.</p>
          <p style="margin-top:24px"><a class="btn dark plate" href="/contact/">Talk to our team <span class="ar">→</span></a></p>
        </div>
        
        <a class="svc-card plate" href="/services/project-management/">
          <div class="pic">
            <img src="/images/svc-project.jpg" style="object-position: 50% 50%" alt="Project Management Services" loading="lazy">
            <span class="pen">01</span>
          </div>
          <div class="tx">
            <h3>Project Management Services</h3>
            <p>Your dedicated on-site technical and commercial proxy for newbuilds, retrofits, conversions and dry-docking.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <a class="svc-card plate" href="/services/shipyard-agent/">
          <div class="pic">
            <img src="/images/svc-shipyard.jpg" style="object-position: 50% 50%" alt="Shipyards Agent &amp; Representative" loading="lazy">
            <span class="pen">02</span>
          </div>
          <div class="tx">
            <h3>Shipyards Agent &amp; Representative</h3>
            <p>Official commercial partner for premier shipyards, with direct access to secured drydock slots.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <a class="svc-card plate" href="/services/spare-parts/">
          <div class="pic">
            <img src="/images/svc-spares.jpg" style="object-position: 50% 50%" alt="Spare Parts Supply &amp; Support" loading="lazy">
            <span class="pen">03</span>
          </div>
          <div class="tx">
            <h3>Spare Parts Supply &amp; Support</h3>
            <p>Genuine OEM and certified aftermarket parts, delivered from Dubai to your port.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <a class="svc-card plate" href="/services/engineering/">
          <div class="pic">
            <img src="/images/svc-engineering.jpg" style="object-position: 50% 50%" alt="Engineering Consultancy in Shipbuilding" loading="lazy">
            <span class="pen">04</span>
          </div>
          <div class="tx">
            <h3>Engineering Consultancy in Shipbuilding</h3>
            <p>An end-to-end engineering pipeline for newbuild designs and complex conversions.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <a class="svc-card plate" href="/services/product-representation/">
          <div class="pic">
            <img src="/images/svc-representation.jpg" style="object-position: 50% 50%" alt="Global Product Representation" loading="lazy">
            <span class="pen">05</span>
          </div>
          <div class="tx">
            <h3>Global Product Representation</h3>
            <p>Your outsourced regional sales force for marine equipment and software.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <a class="svc-card plate" href="/services/chartering/">
          <div class="pic">
            <img src="/images/svc-chartering.jpg" style="object-position: 50% 50%" alt="Ship Chartering Support" loading="lazy">
            <span class="pen">06</span>
          </div>
          <div class="tx">
            <h3>Ship Chartering Support</h3>
            <p>Chartering support and post-fixture management, acting as your outsourced chartering desk.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <a class="svc-card plate" href="/services/welding/">
          <div class="pic">
            <img src="/images/svc-welding.jpg" style="object-position: 50% 50%" alt="Marine &amp; Industry Welder and Welding Qualification Advisory" loading="lazy">
            <span class="pen">07</span>
          </div>
          <div class="tx">
            <h3>Marine &amp; Industry Welder and Welding Qualification Advisory</h3>
            <p>Welder qualification, WPS and PQR with approvals from DNV, ABS, LR and BV.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <a class="svc-card plate" href="/services/inspection/">
          <div class="pic">
            <img src="/images/svc-inspection.jpg" style="object-position: 50% 50%" alt="Fabrication Inspection Services (QA/QC)" loading="lazy">
            <span class="pen">08</span>
          </div>
          <div class="tx">
            <h3>Fabrication Inspection Services (QA/QC)</h3>
            <p>Independent third-party inspection from raw material to final coating.</p>
            <span class="more">Read more</span>
          </div>
        </a>
        
        <div class="svc-cta plate">
          <div><span class="eyebrow">Not sure where to start?</span>
          <h3>Tell us about your vessel or project, and we'll point you to the right service.</h3></div>
          <a class="btn plate" href="/contact/">Talk to our team <span class="ar">→</span></a>
        </div>
      </div>
    </section>
    
  </div>
</BaseLayout>
