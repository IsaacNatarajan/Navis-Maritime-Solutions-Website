---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Partners" description="Navis Maritime Solutions' partner network: class-approved shipyards, equipment manufacturers and specialist marine service providers." nav="partners" page="partners">

  <section class="hero page ph-partners">
    <div class="hero-inner"><div class="wrap rise">
      <span class="tag">Our partners</span>
      <h1>Built on strong <em>alliances.</em></h1>
      <p class="sub">Turnkey engineering, execution and supply, through a trusted global network.</p>
    </div></div>
  </section>
  <div class="body">
    <section class="sec reveal">
      <div class="wrap split intro-split">
        <div><span class="eyebrow">Our Partners</span><p class="statement" style="margin-top:18px">Navis Maritime Solutions builds high-value alliances across the global maritime cluster to deliver turnkey engineering, execution and supply capabilities.</p><p class="intro-body">We believe that complex maritime projects demand integrated expertise. By forming strategic partnerships with class-approved shipyards, elite naval architecture firms and premier component manufacturers, we offer our clients a seamless, end-to-end service ecosystem. Whether you are an international shipyard looking for trusted regional representation or an asset owner seeking optimized engineering workflows, partnering with Navis Maritime Solutions ensures shared technical strength, expanded operational capacity and commercial growth.</p></div>
        <div class="ph-wrap"><div class="ph plate"><img src="/images/partner-hands.jpg" alt="Business handshake" loading="lazy"></div></div>
      </div>
    </section>
    <section class="sec navyband reveal">
      <div class="wrap">
        <div class="sec-head"><div><span class="eyebrow">Who we work with</span><h2>Our partner network</h2></div></div>
        <div class="plist">
          
          <article class="prow plate">
            <div class="plogo plate"><img src="/images/p-precibalance.png" alt="Precibalance logo"></div>
            <div class="pinfo">
              <span class="ptag">Product representation</span>
              <h3>Precibalance</h3>
              <div class="prole">Dynamic Balancing Machines <span>· Tamil Nadu, India</span></div>
              <p>Navis is the commercial representative for Precibalance dynamic balancing machines.</p>
              <p style="margin-top:14px"><a class="tlink" href="/services/product-representation/">Global Product Representation</a></p>
            </div>
            <span class="n">1</span>
          </article>
          
          <article class="prow plate">
            <div class="plogo plate"><img src="/images/p-ioe.png" alt="International Offshore Equipment Pte Ltd logo"></div>
            <div class="pinfo">
              <span class="ptag">Product representation</span>
              <h3>International Offshore Equipment Pte Ltd</h3>
              <div class="prole">Deck Machinery <span>· Singapore</span></div>
              <p>Navis is the commercial representative for International Offshore Equipment deck machinery.</p>
              <p style="margin-top:14px"><a class="tlink" href="/services/product-representation/">Global Product Representation</a></p>
            </div>
            <span class="n">2</span>
          </article>
          
          <article class="prow plate">
            <div class="plogo plate"><img src="/images/p-cdmarine.png" alt="CD Marine, Monte-Carlo logo"></div>
            <div class="pinfo">
              <span class="ptag">Supply partner</span>
              <h3>CD Marine, Monte-Carlo</h3>
              <div class="prole">Engine Spares <span>· Monte-Carlo</span></div>
              <p>Engine spares, supporting our spare parts supply for ships and boats.</p>
              
            </div>
            <span class="n">3</span>
          </article>
          
          <article class="prow plate">
            <div class="plogo plate"><img src="/images/p-xtl.png" alt="XTL Marine L.L.C. logo"></div>
            <div class="pinfo">
              <span class="ptag">Yachting partner</span>
              <h3>XTL Marine L.L.C.</h3>
              <div class="prole">Yachting Solutions</div>
              <p>Yachting solutions, extending our support to yacht owners and operators.</p>
              
            </div>
            <span class="n">4</span>
          </article>
          
          <article class="prow plate">
            <div class="plogo plate"><img src="/images/p-praise.png" alt="Praise Adonai Ships &amp; Boats Repairing logo"></div>
            <div class="pinfo">
              <span class="ptag">Repair partner</span>
              <h3>Praise Adonai Ships &amp; Boats Repairing</h3>
              <div class="prole">Dry Docking, Afloat &amp; Anchorage Repairs in UAE <span>· UAE</span></div>
              <p>Dry docking, afloat and anchorage repairs for vessels in the UAE.</p>
              
            </div>
            <span class="n">5</span>
          </article>
          
        </div>
      </div>
    </section>
    <section class="sec vm-band pw-band reveal">
      <div class="wrap">
        <div class="sec-head"><div><span class="eyebrow">Partner with Navis</span><h2>Shared technical strength</h2></div></div>
        <div class="vm2">
          <div class="vm-card plate"><h3>For shipyards and manufacturers</h3><p>Looking for trusted regional representation? We put your capacity and products in front of shipowners, operators and fleets, with the technical and commercial know-how to turn interest into orders.</p></div><div class="vm-card plate"><h3>For shipowners and operators</h3><p>Our partner network gives you one point of contact for class-approved yards, naval architecture support and certified equipment, with optimized engineering workflows from start to finish.</p></div>
        </div>
      </div>
    </section>
    <section class="sec reveal" style="padding-top:0">
  <div class="wrap"><div class="ctabox plate"><h2>Interested in partnering with Navis?</h2><a class="btn dark plate" href="/contact/">Get in touch <span class="ar">→</span></a></div></div>
</section>
    
  </div>
</BaseLayout>
